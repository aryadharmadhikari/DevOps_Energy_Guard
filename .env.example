# Backend. Docker uses the db service name. For local Python, change db to localhost.
DATABASE_URL=postgresql://energyguard:energyguard@db:5432/energyguard
NOTIFIER_URL=http://notifier:8100
CORS_ORIGINS=http://localhost:5173
MODEL_PATH=/app/ml/models/model.pkl
ALERT_MERGE_MINUTES=10
# Use package when Ameya's installable ml package and model are available.
ML_SCORER=stub

# Vite development. Compose passes /api/v1 as the frontend build argument.
VITE_API_URL=http://localhost:8000/api/v1

BACKEND_URL=http://backend:8000/api/v1
SIM_INTERVAL_SECONDS=5
SIM_METER_COUNT=3

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
NOTIFY_COOLDOWN_SECONDS=300

# PostgreSQL initialization. Keep these consistent with DATABASE_URL.
POSTGRES_USER=energyguard
POSTGRES_PASSWORD=energyguard
POSTGRES_DB=energyguard
