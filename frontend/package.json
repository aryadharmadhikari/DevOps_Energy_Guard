{
  "name": "energyguard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "dev:all": "concurrently -n mock,app -c gray,blue \"npm:mock\" \"npm:dev\"",
